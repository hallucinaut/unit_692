/* ==========================================================================
   MODERN CSS3 BASE / RESET / NORMALIZATION
   "God Mode" - The complete foundation.
   ========================================================================== */

/* 1. GLOBAL BOX SIZING & DEFAULTS */
*, *::before, *::after {
  box-sizing: border-box;
}

/* 2. ROOT CONFIGURATION */
:root {
  -moz-tab-size: 4;
  tab-size: 4;
  color-scheme: light dark;
  
  /* FLUID TYPOGRAPHY TOKENS (Min 320px - Max 1240px) */
  --step--2: clamp(0.78rem, calc(0.77rem + 0.03vw), 0.80rem);
  --step--1: clamp(0.94rem, calc(0.92rem + 0.11vw), 1.00rem);
  --step-0: clamp(1.13rem, calc(1.08rem + 0.22vw), 1.25rem);
  --step-1: clamp(1.35rem, calc(1.28rem + 0.37vw), 1.56rem);
  --step-2: clamp(1.62rem, calc(1.50rem + 0.58vw), 1.95rem);
  --step-3: clamp(1.94rem, calc(1.77rem + 0.87vw), 2.44rem);
  --step-4: clamp(2.33rem, calc(2.08rem + 1.25vw), 3.05rem);
  --step-5: clamp(2.80rem, calc(2.45rem + 1.77vw), 3.82rem);

  /* SPACING TOKENS */
  --space-3xs: clamp(0.31rem, calc(0.31rem + 0.00vw), 0.31rem);
  --space-2xs: clamp(0.56rem, calc(0.54rem + 0.11vw), 0.63rem);
  --space-xs: clamp(0.88rem, calc(0.85rem + 0.11vw), 0.94rem);
  --space-s: clamp(1.13rem, calc(1.08rem + 0.22vw), 1.25rem);
  --space-m: clamp(1.69rem, calc(1.62rem + 0.33vw), 1.88rem);
  --space-l: clamp(2.25rem, calc(2.16rem + 0.43vw), 2.50rem);
  --space-xl: clamp(3.38rem, calc(3.24rem + 0.65vw), 3.75rem);
  --space-2xl: clamp(4.50rem, calc(4.32rem + 0.87vw), 5.00rem);
  --space-3xl: clamp(6.75rem, calc(6.48rem + 1.30vw), 7.50rem);

  /* OKLCH PALETTE (Perceptually Uniform) */
  --color-surface-1: oklch(99% 0 0);
  --color-surface-2: oklch(95% 0 0);
  --color-surface-3: oklch(90% 0 0);
  --color-text-1: oklch(20% 0 0);
  --color-text-2: oklch(35% 0 0);
  --color-brand-1: oklch(60% 0.22 260); /* Deep Blue */
  --color-brand-2: oklch(75% 0.18 260);
  --color-accent: oklch(65% 0.24 20); /* Vibrant Pink */

  --shadow-sm: 0 1px 2px 0 rgb(0 0 0 / 0.05);
  --shadow-md: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
  --shadow-lg: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);

  --radius-sm: 0.25rem;
  --radius-md: 0.5rem;
  --radius-lg: 1rem;
}

@media (prefers-color-scheme: dark) {
  :root {
    --color-surface-1: oklch(15% 0 0);
    --color-surface-2: oklch(20% 0 0);
    --color-surface-3: oklch(25% 0 0);
    --color-text-1: oklch(95% 0 0);
    --color-text-2: oklch(80% 0 0);
    --color-brand-1: oklch(70% 0.18 260);
  }
}

/* 3. HTML & BODY SETUP */
html {
  line-height: 1.6;
  -webkit-text-size-adjust: 100%;
  scroll-behavior: smooth;
  font-family: system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif, 'Apple Color Emoji', 'Segoe UI Emoji';
  background-color: var(--color-surface-1);
  color: var(--color-text-1);
  scrollbar-gutter: stable;
}

body {
  margin: 0;
  min-height: 100vh;
  line-height: inherit;
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  display: flex;
  flex-direction: column;
}

/* 4. TYPOGRAPHY & VERTICAL RHYTHM */
h1, h2, h3, h4, h5, h6 {
  font-weight: 700;
  margin-block-end: var(--space-s);
  line-height: 1.1;
  text-wrap: balance;
  color: var(--color-text-1);
}

h1 { font-size: var(--step-5); }
h2 { font-size: var(--step-4); }
h3 { font-size: var(--step-3); }
h4 { font-size: var(--step-2); }

p {
  margin-block-end: var(--space-m);
  max-width: 65ch; /* Optimal reading length */
  overflow-wrap: break-word;
}

sub, sup {
  font-size: 0.75em;
  line-height: 0;
  position: relative;
  vertical-align: baseline;
}
sub { bottom: -0.25em; }
sup { top: -0.5em; }

a {
  color: var(--color-brand-1);
  text-decoration: underline;
  text-decoration-skip-ink: auto;
  text-underline-offset: 3px;
  transition: color 0.2s ease;
}

a:hover {
  color: var(--color-accent);
}

/* 5. MEDIA */
img, picture, video, canvas, svg {
  display: block;
  max-width: 100%;
  height: auto;
}

/* 6. UTILITIES */
.wrapper {
  width: min(100% - var(--space-m), 75rem);
  margin-inline: auto;
}

.sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border-width: 0;
}

/* 7. REDUCED MOTION */
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
    scroll-behavior: auto !important;
  }
}

