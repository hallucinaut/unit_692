---
import type { CollectionEntry } from 'astro:content';

interface Props {
  skill: CollectionEntry<'skills'>;
}

const { skill } = Astro.props;
---

<div class="skill-card hover-blink">
  <div class="card-header">
    <span class="category">{skill.data.category.toUpperCase()}</span>
  </div>
  <h3 class="skill-title">{skill.data.title}</h3>
  <p class="skill-desc">{skill.data.description}</p>
  <a href={`/skills/${skill.id}`} class="access-btn">
    EXÉCUTER <span class="blink-target">_</span>
  </a>
</div>

<style>
  .skill-card {
    background: var(--color-surface-2);
    border: 1px solid var(--border-color);
    padding: var(--space-l);
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
    position: relative;
    transition: all 0.3s ease;
    overflow: hidden;
    min-height: 220px;
  }

  .skill-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 4px;
    height: 0;
    background: var(--color-brand-1);
    transition: height 0.3s ease;
  }

  .skill-card::after {
    content: '';
    position: absolute;
    top: -2px;
    right: -2px;
    width: 20px;
    height: 20px;
    border-top: 2px solid transparent;
    border-right: 2px solid transparent;
    transition: all 0.3s ease;
  }

  .skill-card:hover {
    border-color: var(--color-brand-1);
    box-shadow: 0 4px 20px rgba(88, 166, 255, 0.15);
    transform: translateY(-2px);
    background: rgba(88, 166, 255, 0.02);
  }

  .skill-card:hover::before {
    height: 100%;
  }

  .skill-card:hover::after {
    border-top-color: var(--color-brand-1);
    border-right-color: var(--color-brand-1);
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-text-dim);
    border-bottom: 1px dashed var(--border-color);
    padding-bottom: var(--space-xs);
    margin-bottom: var(--space-xs);
  }

  .category {
    color: var(--color-accent);
    font-weight: 600;
    letter-spacing: 0.05em;
  }

  .skill-title {
    font-size: var(--step-1);
    font-weight: 700;
    margin: 0 0 var(--space-s) 0;
    font-family: var(--font-mono);
    color: var(--color-brand-1);
    line-height: 1.3;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  .skill-desc {
    font-size: 0.95rem;
    color: var(--color-text-2);
    margin: 0;
    line-height: 1.6;
    font-family: var(--font-sans);
    flex-grow: 1;
  }

  .access-btn {
    margin-top: auto;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-brand-1);
    text-decoration: none;
    padding: var(--space-xs) var(--space-s);
    border: 1px solid var(--color-brand-1);
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    align-self: flex-start;
    transition: all 0.2s ease;
    background: transparent;
  }

  .access-btn:hover {
    background: var(--color-brand-1);
    color: #000;
    box-shadow: 0 0 10px rgba(88, 166, 255, 0.3);
  }

  /* Mobile adjustments */
  @media (max-width: 600px) {
    .skill-card {
      padding: var(--space-m);
      min-height: 200px;
    }

    .skill-title {
      font-size: var(--step-0);
    }

    .skill-desc {
      font-size: 0.9rem;
    }

    .access-btn {
      font-size: 0.75rem;
      padding: var(--space-xs);
    }
  }
</style>
