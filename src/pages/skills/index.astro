---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SkillCard from '../../components/ui/SkillCard.astro';

const skills = await getCollection('skills');

const title = 'Compétences Agent';
const description = 'Modules et outils pour agents autonomes.';
---

<BaseLayout title={title} description={description}>
  <div class="grid-overlay"></div>

  <section class="archive-header wrapper">
    <h1 class="page-title">
      <span class="prefix">>></span> COMPÉTENCES_AGENT <span class="dim">//</span> SKILLS
    </h1>
    <p class="page-desc">
      [CHARGEMENT_MODULES]... {skills.length} FONCTIONNALITÉS DISPONIBLES.
    </p>
  </section>

	<section class="skills-grid wrapper">
    <div class="grid-layout">
  		{skills.map((skill) => (
  			<SkillCard skill={skill} />
  		))}
    </div>
	</section>
</BaseLayout>

<style>
  .grid-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image:
      linear-gradient(var(--border-color) 1px, transparent 1px),
      linear-gradient(90deg, var(--border-color) 1px, transparent 1px);
    background-size: 50px 50px;
    background-position: center;
    opacity: 0.1;
    pointer-events: none;
    z-index: -1;
  }

  .archive-header {
    padding-block: var(--space-2xl) var(--space-xl);
    position: relative;
    margin-bottom: var(--space-2xl);
  }

  .archive-header::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 2px;
    background: linear-gradient(90deg, var(--color-brand-1), transparent);
  }

  .archive-header::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 60%;
    height: 1px;
    background: var(--border-color);
  }

  .page-title {
    font-size: var(--step-4);
    font-family: var(--font-mono);
    color: var(--color-brand-1);
    text-transform: uppercase;
    letter-spacing: 0.02em;
    margin-bottom: var(--space-m);
    position: relative;
    display: inline-block;
  }

  .page-title::after {
    content: '';
    position: absolute;
    bottom: -0.5rem;
    left: 0;
    width: 40px;
    height: 3px;
    background: var(--color-brand-2);
  }

  .prefix {
    color: var(--color-accent);
    margin-right: 0.5rem;
    font-weight: 700;
  }

  .dim {
    color: var(--color-text-dim);
    font-weight: 400;
  }

  .page-desc {
    font-family: var(--font-mono);
    color: var(--color-text-2);
    font-size: var(--step-0);
    border-left: 3px solid var(--color-brand-1);
    background: rgba(88, 166, 255, 0.05);
    padding: var(--space-s) var(--space-m);
    margin-top: var(--space-l);
    max-width: 600px;
  }

  .skills-grid {
    padding-bottom: var(--space-2xl);
  }

  .grid-layout {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
    gap: var(--space-l);
    margin-bottom: var(--space-2xl);
  }

  /* Mobile responsive adjustments */
  @media (max-width: 600px) {
    .archive-header {
      padding-block: var(--space-xl) var(--space-m);
      margin-bottom: var(--space-l);
    }

    .page-title {
      font-size: var(--step-2);
      line-height: 1.3;
    }

    .page-desc {
      font-size: 0.85rem;
      padding: var(--space-xs) var(--space-s);
      margin-top: var(--space-m);
    }

    .grid-layout {
      gap: var(--space-m);
      grid-template-columns: 1fr;
    }
  }

  @media (min-width: 601px) and (max-width: 900px) {
    .page-title {
      font-size: var(--step-3);
    }

    .grid-layout {
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    }
  }
</style>
