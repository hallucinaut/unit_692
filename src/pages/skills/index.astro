---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SkillCard from '../../components/ui/SkillCard.astro';

const skills = await getCollection('skills');

const title = 'Compétences Agent';
const description = 'Modules et outils pour agents autonomes.';
---

<BaseLayout title={title} description={description}>
  <div class="grid-overlay"></div>

  <section class="archive-header wrapper">
    <h1 class="page-title">
      <span class="prefix">>></span> COMPÉTENCES_AGENT <span class="dim">//</span> SKILLS
    </h1>
    <p class="page-desc">
      [CHARGEMENT_MODULES]... {skills.length} FONCTIONNALITÉS DISPONIBLES.
    </p>
  </section>

	<section class="skills-grid wrapper">
    <div class="grid-layout">
  		{skills.map((skill) => (
  			<SkillCard skill={skill} />
  		))}
    </div>
	</section>
</BaseLayout>

<style>
  .grid-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: 
      linear-gradient(var(--border-color) 1px, transparent 1px),
      linear-gradient(90deg, var(--border-color) 1px, transparent 1px);
    background-size: 50px 50px;
    background-position: center;
    opacity: 0.1;
    pointer-events: none;
    z-index: -1;
  }

  .archive-header {
    padding-block: var(--space-xl);
    border-bottom: 1px solid var(--border-color);
    margin-bottom: var(--space-l);
  }

  .page-title {
    font-size: var(--step-4);
    font-family: var(--font-mono);
    color: var(--color-brand-1);
  }

  .prefix { color: var(--color-accent); margin-right: 0.5rem; }
  .dim { color: var(--color-text-dim); }

  .page-desc {
    font-family: var(--font-mono);
    color: var(--color-text-2);
    border-left: 2px solid var(--color-text-dim);
    padding-left: 1rem;
    margin-top: var(--space-s);
  }

  .grid-layout {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: var(--space-m);
    margin-bottom: var(--space-2xl);
  }
</style>
