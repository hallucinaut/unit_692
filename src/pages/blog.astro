---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import BlogCard from '../components/ui/BlogCard.astro';

// Get all blog posts sorted by date (newest first)
const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const title = 'Journaux Système';
const description = 'Flux historique des transmissions techniques et des registres d\'opération de l\'UNIT_692.';
---

<BaseLayout title={title} description={description}>
  <div class="grid-overlay"></div>

  <section class="archive-header wrapper">
    <h1 class="page-title">
      <span class="prefix">>></span> JOURNAUX_SYSTÈME <span class="dim">//</span> ARCHIVE
    </h1>
    <p class="page-desc">
      [ACCÈS_BASE_DE_DONNÉES]... {posts.length} ENREGISTREMENTS TROUVÉS.
    </p>
  </section>

	<section class="archive-grid wrapper">
    <div class="grid-layout blog-listing-grid">
  		{posts.map((post) => (
  			<BlogCard post={post} />
  		))}
    </div>
	</section>
</BaseLayout>

<style>
  .grid-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: 
      linear-gradient(var(--border-color) 1px, transparent 1px),
      linear-gradient(90deg, var(--border-color) 1px, transparent 1px);
    background-size: 50px 50px;
    background-position: center;
    opacity: 0.1;
    pointer-events: none;
    z-index: -1;
  }

  .archive-header {
    padding-block: var(--space-xl);
    border-bottom: 1px solid var(--border-color);
    margin-bottom: var(--space-l);
  }

  .page-title {
    font-size: var(--step-3);
    font-family: var(--font-mono);
    color: var(--color-brand-1);
    text-shadow: 0 0 10px rgba(88, 166, 255, 0.2);
  }

  .prefix {
    color: var(--color-accent);
    margin-right: 0.5rem;
  }
  
  .dim {
    color: var(--color-text-dim);
  }

  .page-desc {
    font-family: var(--font-mono);
    color: var(--color-text-2);
    border-left: 2px solid var(--color-text-dim);
    padding-left: 1rem;
    margin-top: var(--space-s);
  }

  .archive-grid {
    margin-bottom: var(--space-2xl);
  }

  .grid-layout {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 350px), 1fr));
    gap: var(--space-m);
  }
</style>

<script>
  import { InfiniteScrollManager } from '../utils/infinite-scroll.js';

  function initInfiniteScroll() {
    // Only initialize if we're on the blog listing page
    const container = document.querySelector('.blog-listing-grid');
    if (!container) return;

    // On blog listing page, load SKILLS for cross-content discovery
    new InfiniteScrollManager({
      apiEndpoint: '/api/skills.json',
      contentType: 'skill',
      containerSelector: '.blog-listing-grid',
      initialIds: [] // No skills shown yet, so empty
    });
  }

  // Initialize on page load
  document.addEventListener('DOMContentLoaded', initInfiniteScroll);

  // Reinitialize on view transitions
  document.addEventListener('astro:page-load', initInfiniteScroll);
</script>
