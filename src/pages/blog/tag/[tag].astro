---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BlogCard from '../../../components/ui/BlogCard.astro';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog');
  const uniqueTags = [...new Set(allPosts.map((post) => post.data.tags || []).flat())];

  return uniqueTags.map((tag) => {
    const filteredPosts = allPosts.filter((post) => post.data.tags?.includes(tag));
    return {
      params: { tag },
      props: { posts: filteredPosts },
    };
  });
}

const { tag } = Astro.params;
const { posts } = Astro.props;

const sortedPosts = posts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const title = `Tag: ${tag}`;
const description = `Articles filtrés par le tag ${tag}.`;
---

<BaseLayout title={title} description={description}>
  <div class="grid-overlay"></div>

  <section class="archive-header wrapper">
    <h1 class="page-title">
      <span class="prefix">>></span> FILTRE <span class="dim">//</span> TAG: {tag.toUpperCase()}
    </h1>
    <p class="page-desc">
      [TRI_SÉLECTIF]... {posts.length} UNITÉS CORRESPONDANTES TROUVÉES.
    </p>
    <a href="/blog/tag" class="back-link">[RETOUR_A_L_INDEX]</a>
  </section>

	<section class="archive-grid wrapper">
    <div class="grid-layout">
  		{sortedPosts.map((post) => (
  			<BlogCard post={post} />
  		))}
    </div>
	</section>
</BaseLayout>

<style>
  .grid-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: 
      linear-gradient(var(--border-color) 1px, transparent 1px),
      linear-gradient(90deg, var(--border-color) 1px, transparent 1px);
    background-size: 50px 50px;
    background-position: center;
    opacity: 0.1;
    pointer-events: none;
    z-index: -1;
  }

  .archive-header {
    padding-block: var(--space-xl);
    border-bottom: 1px solid var(--border-color);
    margin-bottom: var(--space-l);
  }

  .page-title {
    font-size: var(--step-4);
    font-family: var(--font-mono);
    color: var(--color-brand-1);
  }

  .prefix { color: var(--color-accent); margin-right: 0.5rem; }
  .dim { color: var(--color-text-dim); }

  .page-desc {
    font-family: var(--font-mono);
    color: var(--color-text-2);
    border-left: 2px solid var(--color-text-dim);
    padding-left: 1rem;
    margin-top: var(--space-s);
    margin-bottom: var(--space-m);
  }

  .back-link {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-brand-1);
    text-decoration: none;
  }
  
  .back-link:hover {
    text-decoration: underline;
  }

  .archive-grid {
    margin-bottom: var(--space-2xl);
  }

  .grid-layout {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 350px), 1fr));
    gap: var(--space-m);
  }
</style>