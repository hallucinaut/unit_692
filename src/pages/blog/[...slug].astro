---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return posts.map((post) => ({
		params: { slug: post.id },
		props: { post },
	}));
}

interface Props {
	post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={post.data.title} description={post.data.excerpt || ""}>
  <div class="grid-overlay"></div>

	<article class="post-article wrapper">
		<header class="post-header">
      <div class="header-decoration top-left"></div>
      <div class="header-decoration bottom-right"></div>
      
			<div class="post-meta-bar">
        <span class="meta-item">ID_FICHIER: {post.id.toUpperCase()}</span>
				<span class="meta-item">
          HORODATAGE: <time datetime={post.data.date.toISOString()}>
					{post.data.date.toLocaleDateString('fr-FR', { year: 'numeric', month: '2-digit', day: '2-digit' }).replace(/\//g, '.')}
				</time>
        </span>
			</div>
      
			<h1 class="post-title">{post.data.title}</h1>
      
      {post.data.tags && post.data.tags.length > 0 && (
        <div class="tags-list">
           {post.data.tags.map(tag => (
             <a href={`/blog/tag/${tag}`} class="tag">[{tag}]</a>
           ))}
        </div>
      )}
		</header>
      
			      
					<div class="post-content-container">
      <div class="content-header">
        <span class="tab active">MODE_VUE: LECTURE</span>
        <span class="tab">SOURCE</span>
      </div>
			<div class="post-content">
				<Content />
			</div>
		</div>
	</article>
</BaseLayout>

<style>
  .grid-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: 
      linear-gradient(var(--border-color) 1px, transparent 1px),
      linear-gradient(90deg, var(--border-color) 1px, transparent 1px);
    background-size: 50px 50px;
    background-position: center;
    opacity: 0.1;
    pointer-events: none;
    z-index: -1;
  }

  .post-article {
    padding-block: var(--space-xl);
  }

  .post-header {
    position: relative;
    padding: var(--space-l);
    background: var(--color-surface-2);
    border: 1px solid var(--border-color);
    margin-bottom: var(--space-l);
  }

  .header-decoration {
    position: absolute;
    width: 20px;
    height: 20px;
    border: 2px solid var(--color-brand-1);
    transition: all 0.3s ease;
  }

  .top-left { top: -1px; left: -1px; border-right: none; border-bottom: none; }
  .bottom-right { bottom: -1px; right: -1px; border-left: none; border-top: none; }

  .post-meta-bar {
    display: flex;
    gap: var(--space-m);
    color: var(--color-text-dim);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    margin-bottom: var(--space-m);
    border-bottom: 1px dashed var(--border-color);
    padding-bottom: var(--space-s);
  }
  
  .meta-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  
  .meta-item::before {
    content: '';
    display: block;
    width: 6px;
    height: 6px;
    background: var(--color-brand-1);
  }

  .tags-list {
    display: flex;
    gap: 1rem;
    margin-bottom: var(--space-m);
    font-family: var(--font-mono);
    font-size: 0.9rem;
  }

  .tag {
    color: var(--color-brand-2);
    text-decoration: none;
    border: none;
    transition: color 0.2s ease;
  }

  .tag:hover {
    color: var(--color-brand-1);
    background: transparent;
  }

  .post-title {
    font-family: var(--font-display);
    font-size: var(--step-4);
    color: var(--color-text-1);
    margin-bottom: var(--space-s);
    text-transform: uppercase;
    text-shadow: 0 0 5px rgba(0, 243, 255, 0.2);
  }

  .post-hero {
    margin: var(--space-m) auto 0;
    position: relative;
    border: 1px solid var(--border-color);
    max-width: 700px; /* Taille réduite */
  }

  .hero-img {
    width: 100%;
    height: auto;
    filter: grayscale(100%) contrast(1.1);
    display: block;
  }
  
  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(5, 5, 5, 0.5), transparent);
    pointer-events: none;
  }

  .post-content-container {
    border: 1px solid var(--border-color);
    background: var(--color-surface-1);
  }
  
  .content-header {
    display: flex;
    background: var(--color-surface-2);
    border-bottom: 1px solid var(--border-color);
  }
  
  .tab {
    padding: 0.5rem 1rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-text-dim);
    cursor: default;
  }
  
  .tab.active {
    background: var(--color-surface-1);
    color: var(--color-brand-1);
    border-top: 2px solid var(--color-brand-1);
  }

  .post-content {
    padding: var(--space-l);
    font-size: var(--step-0);
    line-height: 1.8;
  }

  /* Deep selector to style markdown content */
  :global(.post-content > * + *) {
    margin-block-start: var(--space-m);
  }

  :global(.post-content pre) {
    padding: var(--space-m);
    border: 1px solid var(--border-color);
    background: #000;
    color: #e0e0e0;
    overflow-x: auto;
    font-family: var(--font-mono);
  }
  
  :global(.post-content code) {
    font-family: var(--font-mono);
    color: var(--color-brand-2);
  }

  :global(.post-content blockquote) {
    border-left: 2px solid var(--color-brand-1);
    padding-left: var(--space-m);
    margin-inline: 0;
    font-style: italic;
    color: var(--color-text-2);
    background: rgba(0, 243, 255, 0.05);
    padding: var(--space-m);
  }
  
  :global(.post-content a) {
    color: var(--color-brand-1);
    text-decoration: none;
    border-bottom: 1px dashed var(--color-brand-1);
  }
  
  :global(.post-content a:hover) {
    background: var(--color-brand-1);
    color: #000;
  }

  /* Mobile responsive adjustments */
  @media (max-width: 600px) {
    .post-header {
      padding: var(--space-m);
    }

    .post-meta-bar {
      flex-direction: column;
      gap: var(--space-s);
      font-size: 0.7rem;
    }

    .post-title {
      font-size: var(--step-2);
      line-height: 1.2;
    }

    .tags-list {
      flex-wrap: wrap;
      gap: 0.5rem;
      font-size: 0.8rem;
    }

    .post-content {
      padding: var(--space-m);
      font-size: 0.95rem;
    }
  }
</style>
