---
import { getCollection } from 'astro:content';
import BlogLayout from '../../layouts/BlogLayout.astro';
import { formatDate, formatShortDate } from '../../lib/date';

// Get all posts for static generation
export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return posts.map((post) => ({
		params: { slug: post.slug },
		props: { post },
	}));
}

// Get the specific post from props
const { post } = Astro.props;

if (!post) {
	Astro.redirect('/blog');
}

// Get all posts for the sidebar/similar posts
const postsData = await getCollection('blog');
const sortedPostsData = postsData.sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf()
).slice(0, 5);

const title = post.data.title;
const description = post.data.description || post.data.excerpt;

// Use a simple markdown renderer
import MarkdownIt from 'markdown-it';
const md = new MarkdownIt();
const content = md.render(post.body);
---

<BlogLayout title={title} description={description}>
	<article>
		<h1>{post.data.title}</h1>
		{post.data.author && (
			<p>
				By <cite>{post.data.author}</cite>
			</p>
		)}
		<time datetime={post.data.date}>
			{formatDate(post.data.date)}
		</time>

		<hr />

		<div class="content" set:html={content} />

		{post.data.tags?.length > 0 && (
			<div class="tags">
				<h3>Tags:</h3>
				{post.data.tags.map((tag) => (
					<a href={`/blog/tag/${tag}/`}>{tag}</a>
				))}
			</div>
		)}

		{post.data.excerpt && (
			<div class="excerpt">
				<h3>Summary</h3>
				<p>{post.data.excerpt}</p>
			</div>
		)}
	</article>

	<section class="sidebar">
		<h3>Recent Posts</h3>
		{sortedPostsData.map((p) => (
			<a href={`/blog/${p.slug}/`}>
				<h4>{p.data.title}</h4>
				<time datetime={p.data.date.toISOString()}>
					{formatShortDate(p.data.date)}
				</time>
			</a>
		))}
	</section>
</BlogLayout>
