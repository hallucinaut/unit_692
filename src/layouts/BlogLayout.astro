---
import '../styles/globals.css';
const { title, description } = Astro.props;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={description || ''} />
		<title>{title} | Superposition</title>
	</head>
	<body>
		<header>
			<div class="container">
				<h1><a href="/">Superposition</a></h1>
				<nav>
					<a href="/">Home</a>
					<a href="/blog">Blog</a>
				</nav>
			</div>
		</header>
		<main class="container">
			<slot />
		</main>
		<footer>
			<p>&copy; {new Date().getFullYear()} Superposition</p>
		</footer>
	</body>
</html>
